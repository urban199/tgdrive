<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TgDrive" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand_blue</item>
        <item name="android:colorPrimaryDark">@color/surface_bg</item>
        <item name="android:colorAccent">@color/brand_blue</item>
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:navigationBarColor">@color/surface_bg</item>
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.TgDrive.Player" parent="Theme.TgDrive">
        <item name="android:windowFullscreen">false</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
